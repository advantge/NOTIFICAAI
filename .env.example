# Aplicação
APP_ENV=demo
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-bytes
ENCRYPTION_KEY=replace-with-32-byte-base64-key
STORE_TIMEZONE=America/Fortaleza

# Supabase (server-only; never expose the service/secret key to the browser)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Provedor de pagamento
PAYMENT_PROVIDER=mock
PAGBANK_ENABLED=false
PAGBANK_ENV=sandbox
PAGBANK_API_BASE_URL=https://sandbox.api.pagseguro.com
PAGBANK_ACCESS_TOKEN=
PAGBANK_WEBHOOK_URL=
PAGBANK_WEBHOOK_SECRET=
PAGBANK_ACCOUNT_ID=
PAGBANK_PIX_KEY=

# MCP
MCP_ENABLED=false
MCP_AUTH_TOKEN=
MCP_ROLE=ADMIN

# Observabilidade
LOG_LEVEL=info
WEBHOOK_MAX_BYTES=65536
WEBHOOK_MAX_ATTEMPTS=5
